# Template for /opt/synapse-rag/.env on the code-interpreter server.
# cp .env.synapse.example .env && chmod 600 .env, then fill in every blank value.

# --- compose plumbing (read by docker compose itself) ---
# A bare `docker compose` in this directory must never pick upstream's unsafe docker-compose.yaml.
COMPOSE_FILE=docker-compose.synapse.yml
# Rewritten by scripts/synapse-deploy.sh on every deploy.
RAG_IMAGE_TAG=latest

# --- auth ---
# MUST be byte-identical to JWT_SECRET in /opt/synapse/.env on the Synapse app server.
JWT_SECRET=

# --- logging ---
CONSOLE_JSON=true
# true also mounts the unauthenticated /pgvector debug routes; never enable in production.
DEBUG_RAG_API=false

# --- vector DB ---
VECTOR_DB_TYPE=pgvector
POSTGRES_DB=synapse_rag
POSTGRES_USER=synapse_rag
# openssl rand -hex 24
POSTGRES_PASSWORD=
COLLECTION_NAME=synapse
PG_POOL_PRE_PING=true
PGVECTOR_CREATE_EXTENSION=true
# (cmetadata->>'file_id') index; keeps per-file queries fast as the table grows.
PGVECTOR_CREATE_LEGACY_INDEXES=true
# A fresh database is created with JSONB metadata already.
PGVECTOR_MIGRATE_CMETADATA_JSONB=false
PGVECTOR_CREATE_CMETADATA_GIN_INDEX=true

# --- embeddings: Gemini via OpenRouter's OpenAI-compatible endpoint ---
# Changing provider/model/dimensions later requires re-embedding every file.
# "openai" means OpenAI-compatible API (OpenRouter). Do NOT use google_genai: it bypasses
# OpenRouter and needs a Google API key.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=google/gemini-embedding-001
# Native output is 3072; 1536 halves storage and stays under pgvector's 2000-dim ANN index limit.
EMBEDDINGS_DIMENSIONS=1536
RAG_OPENAI_BASEURL=https://openrouter.ai/api/v1
# Dedicated OpenRouter key with its own spend limit is recommended.
RAG_OPENAI_API_KEY=
# Send raw strings instead of tiktoken ID arrays; Gemini rejects token arrays.
RAG_CHECK_EMBEDDING_CTX_LENGTH=false
# Texts per embeddings HTTP call. gemini-embedding-2 rejects more than 100 per request.
EMBEDDINGS_CHUNK_SIZE=100

# --- chunking and large-file throughput ---
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
# OCR of embedded PDF images is the biggest memory/CPU cost on large PDFs.
PDF_EXTRACT_IMAGES=false
EMBEDDING_BATCH_SIZE=750
EMBEDDING_MAX_QUEUE_SIZE=3
# Concurrent embed+insert consumers per file.
PARALLEL_EXECUTION=3
# Per uvicorn worker (the compose file runs 2 workers).
RAG_THREAD_POOL_SIZE=4
